module sh.sysl.sdl3_ttf

import sh.sysl.sdl3_ttf.c
import sysl.text.{cstring, from_cstring}
import sh.sysl.sdl3.{Color, Renderer, Surface, Texture}
import sh.sysl.sdl3.c.Surface as CSurface

// SDL_ttf 3 — a font file, and text rendered out of it onto a surface.
//
// **`SDL_Color` crosses by value, and that is worth saying out loud**, because the Scala binding to
// this same library cannot do it: Scala Native mis-marshals a small by-value struct argument, so it
// packs the four channels into a `uint32` by hand and relies on an aggregate of four bytes and a
// `uint32` being passed in the same register — true on SysV-AMD64 and AArch64, and a bet everywhere
// else. Nothing of the sort is needed here. `tests.sysl` proves it the only way that is worth
// anything: it renders shaded text, whose background fills the surface, and reads pixel (0, 0)
// back. A colour that arrived as bytes derived from an argument pointer gives some other number.
//
// **A render answers a CPU surface**, which is uploaded to the GPU with
// `Renderer.create_texture_from_surface` — or with `Font.texture`, which does both and lets the
// surface go.
//
// **`init` and `quit` are named `ttf_init` and `ttf_quit`** so that a program importing this
// alongside `sh.sysl.sdl3` has no clash to resolve. Everything else here is a method on `Font`.
//
// **The style mask stays a mask**, in `c`, because several styles are true at once and that is what
// an enumeration cannot say. Hinting and wrap alignment are enumerations and are named here.

// Bring SDL_ttf up. Call it after SDL itself is initialised.
ttf_init() -> bool = c.init()

ttf_quit() = c.quit()

// The SDL_ttf being linked, as `(major, minor, patch)`.
ttf_version() -> (int, int, int)
    val v = int(c.version())

    (v / 1000000, (v / 1000) % 1000, v % 1000)
end ttf_version

// How many times `ttf_init` has been called without a matching `ttf_quit`.
ttf_was_init() -> i32 = c.was_init()

// ## Hinting

// How glyph outlines are fitted to the pixel grid.
enum Hinting
    // Standard grid-fitting.
    Normal

    // Subtle adjustments — what most desktop text wants.
    Light

    // For low resolutions, where a glyph has to snap to whole pixels.
    Mono

    // None at all, which keeps the outline's proportions and blurs its stems.
    Off

    // Light hinting with subpixel positioning, the most precise of them.
    //
    // **It does not read back.** SDL_ttf stores this as light hinting plus a separate subpixel
    // flag, and `TTF_GetFontHinting` reports only the hinting half — so a font set to this answers
    // `Light`. That is the library's behaviour rather than this binding's, and `tests.sysl` pins
    // it so that the missing round trip is a documented fact rather than a suspicion.
    LightSubpixel

    // What SDL_ttf answers for a font it cannot say this about. It is `-1`, so it is a real answer
    // rather than a missing one.
    Invalid

    Other(code: i32)

    code(self) -> i32
        self match
            Normal -> c.HINTING_NORMAL
            Light -> c.HINTING_LIGHT
            Mono -> c.HINTING_MONO
            Off -> c.HINTING_NONE
            LightSubpixel -> c.HINTING_LIGHT_SUBPIXEL
            Invalid -> c.HINTING_INVALID
            Other(n) -> n

    of(code: i32) -> Hinting
        code match
            c.HINTING_NORMAL -> Normal
            c.HINTING_LIGHT -> Light
            c.HINTING_MONO -> Mono
            c.HINTING_NONE -> Off
            c.HINTING_LIGHT_SUBPIXEL -> LightSubpixel
            c.HINTING_INVALID -> Invalid
            n -> Other(n)
end Hinting

impl Eq for Hinting
    eq(self, other: Hinting) -> bool = self.code() == other.code()

impl Display for Hinting
    display(self, out: *Writer, fmt: FormatSpec)
        val s = self match
            Normal -> "normal"
            Light -> "light"
            Mono -> "mono"
            Off -> "none"
            LightSubpixel -> "light subpixel"
            Invalid -> "invalid"
            Other(_) -> "an unknown hinting"

        display_str(s, out, fmt)

// ## Wrap alignment

// How the lines of wrapped text line up with each other.
enum WrapAlignment
    Left
    Center
    Right

    // What SDL_ttf answers for a font that has not been told.
    Invalid

    Other(code: i32)

    code(self) -> i32
        self match
            Left -> c.ALIGN_LEFT
            Center -> c.ALIGN_CENTER
            Right -> c.ALIGN_RIGHT
            Invalid -> c.ALIGN_INVALID
            Other(n) -> n

    of(code: i32) -> WrapAlignment
        code match
            c.ALIGN_LEFT -> Left
            c.ALIGN_CENTER -> Center
            c.ALIGN_RIGHT -> Right
            c.ALIGN_INVALID -> Invalid
            n -> Other(n)
end WrapAlignment

impl Eq for WrapAlignment
    eq(self, other: WrapAlignment) -> bool = self.code() == other.code()

impl Display for WrapAlignment
    display(self, out: *Writer, fmt: FormatSpec)
        val s = self match
            Left -> "left"
            Center -> "center"
            Right -> "right"
            Invalid -> "invalid"
            Other(_) -> "an unknown alignment"

        display_str(s, out, fmt)

// ## Fonts

// A loaded font at a point size.
struct Font
    handle: *c.Font

    // ## Metrics

    // The tallest a glyph gets, in pixels — what a single line of text occupies.
    height(&self) -> i32 = c.get_font_height(self.handle)

    // How far the tallest glyph rises above the baseline.
    ascent(&self) -> i32 = c.get_font_ascent(self.handle)

    // How far the lowest descends below it, as a negative number.
    descent(&self) -> i32 = c.get_font_descent(self.handle)

    // The recommended step from one baseline to the next, which is what a paragraph should use
    // rather than `height` — a font may want more or less leading than its glyphs strictly need.
    line_skip(&self) -> i32 = c.get_font_line_skip(self.handle)

    weight(&self) -> i32 = c.get_font_weight(self.handle)

    // The family the file declares — "Arial" — or `""` where it declares none.
    family_name(&self) -> string = from_cstring(c.get_font_family_name(self.handle)).unwrap_or("")

    // The face within the family — "Bold Italic".
    style_name(&self) -> string = from_cstring(c.get_font_style_name(self.handle)).unwrap_or("")

    // Whether the font can draw this code point. A run of text with a character the font lacks
    // renders a fallback box, so this is what a picker checks before offering a font.
    has_glyph(&self, ch: u32) -> bool = c.font_has_glyph(self.handle, ch)

    // ## Settings

    size(&self) -> f32 = c.get_font_size(self.handle)

    // Change the point size in place, which is cheaper than opening the file again.
    set_size(&self, ptsize: f32) -> bool = c.set_font_size(self.handle, ptsize)

    // The synthesised styles, a mask of `c`'s `STYLE_*` values. These are drawn by SDL_ttf rather
    // than taken from a bold or italic face, so a real bold file looks better where there is one.
    style(&self) -> u32 = c.get_font_style(self.handle)

    set_style(&self, style: u32) = c.set_font_style(self.handle, style)

    // An outline of this many pixels around every glyph, for text over an unpredictable background.
    // Zero turns it off.
    outline(&self) -> i32 = c.get_font_outline(self.handle)

    set_outline(&self, pixels: i32) -> bool = c.set_font_outline(self.handle, pixels)

    hinting(&self) -> Hinting = Hinting.of(c.get_font_hinting(self.handle))

    set_hinting(&self, hinting: Hinting) = c.set_font_hinting(self.handle, hinting.code())

    kerning(&self) -> bool = c.get_font_kerning(self.handle)

    // Kerning is on to begin with. Turning it off is for laying text out on a grid, where every
    // advance has to be the same.
    set_kerning(&self, on: bool) = c.set_font_kerning(self.handle, on)

    // How wrapped lines line up with each other.
    wrap_alignment(&self) -> WrapAlignment = WrapAlignment.of(c.get_font_wrap_alignment(self.handle))

    set_wrap_alignment(&self, align: WrapAlignment) =
        c.set_font_wrap_alignment(self.handle, align.code())

    // ## Measuring

    // The pixels a string would occupy, without rendering it. What a layout asks before it decides
    // where anything goes.
    measure(&self, text: string) -> (i32, i32)
        val t = cstring(text)

        var w: i32 = 0
        var h: i32 = 0

        c.get_string_size(self.handle, t.ptr, c.NUL_TERMINATED, &w, &h)
        (w, h)
    end measure

    // The same for text wrapped at a width. Zero wraps only on newlines.
    measure_wrapped(&self, text: string, wrap: i32) -> (i32, i32)
        val t = cstring(text)

        var w: i32 = 0
        var h: i32 = 0

        c.get_string_size_wrapped(self.handle, t.ptr, c.NUL_TERMINATED, wrap, &w, &h)
        (w, h)
    end measure_wrapped

    // How much of a string fits in `max_width`: the width it actually took, and how many **bytes**
    // of it that was. This is what an editor uses to place a cursor from a mouse position, and what
    // an ellipsis needs to know where to cut.
    fit(&self, text: string, max_width: i32) -> (i32, usize)
        val t = cstring(text)

        var w: i32 = 0
        var n: usize = 0

        c.measure_string(self.handle, t.ptr, c.NUL_TERMINATED, max_width, &w, &n)
        (w, n)
    end fit

    // ## Rendering

    // Fast and aliased, on a transparent background. The cheapest of the four, and the one that
    // looks worst at a large size.
    render_solid(&self, text: string, fg: Color) -> Option[&Surface]
        val t = cstring(text)

        surface_of(c.render_solid(self.handle, t.ptr, c.NUL_TERMINATED, fg))
    end render_solid

    // Antialiased, on a solid box of `bg`. The whole surface is filled with the background, which
    // is why this is the render that proves a colour crossed by value.
    render_shaded(&self, text: string, fg: Color, bg: Color) -> Option[&Surface]
        val t = cstring(text)

        surface_of(c.render_shaded(self.handle, t.ptr, c.NUL_TERMINATED, fg, bg))
    end render_shaded

    // Antialiased with an alpha channel — the usual choice, and what a HUD or a label wants.
    render_blended(&self, text: string, fg: Color) -> Option[&Surface]
        val t = cstring(text)

        surface_of(c.render_blended(self.handle, t.ptr, c.NUL_TERMINATED, fg))
    end render_blended

    // Subpixel-antialiased on a solid background, which reads better on an LCD at small sizes and
    // is wrong on anything rotated or scaled.
    render_lcd(&self, text: string, fg: Color, bg: Color) -> Option[&Surface]
        val t = cstring(text)

        surface_of(c.render_lcd(self.handle, t.ptr, c.NUL_TERMINATED, fg, bg))
    end render_lcd

    // The wrapped forms. `wrap` is a width in pixels; zero wraps only where the text has newlines.
    render_solid_wrapped(&self, text: string, fg: Color, wrap: i32) -> Option[&Surface]
        val t = cstring(text)

        surface_of(c.render_solid_wrapped(self.handle, t.ptr, c.NUL_TERMINATED, fg, wrap))
    end render_solid_wrapped

    render_shaded_wrapped(&self, text: string, fg: Color, bg: Color, wrap: i32) -> Option[&Surface]
        val t = cstring(text)

        surface_of(c.render_shaded_wrapped(self.handle, t.ptr, c.NUL_TERMINATED, fg, bg, wrap))
    end render_shaded_wrapped

    render_blended_wrapped(&self, text: string, fg: Color, wrap: i32) -> Option[&Surface]
        val t = cstring(text)

        surface_of(c.render_blended_wrapped(self.handle, t.ptr, c.NUL_TERMINATED, fg, wrap))
    end render_blended_wrapped

    // Blended text straight to a GPU texture — the two-step every caller was going to write, with
    // the surface let go in between. A texture per label, rebuilt when the label changes, is what a
    // UI should do rather than rendering text every frame.
    texture(&self, renderer: &Renderer, text: string, fg: Color) -> Option[&Texture]
        self.render_blended(text, fg) match
            Some(s) -> renderer.create_texture_from_surface(s)
            None -> None
    end texture
end Font

// The font goes when the last reference to it does. `TTF_CloseFont` after `TTF_Quit` is a
// use-after-free, so a program that calls `ttf_quit` should let its fonts go first — the same rule
// `sdl3`'s `quit` carries, for the same reason.
impl Drop for Font
    drop(self) = c.close_font(self.handle)

// Open a font file at a point size. Nothing if it will not open, with the reason in
// `sh.sysl.sdl3.error`.
open_font(path: string, ptsize: f32) -> Option[&Font]
    val p = cstring(path)
    val f = c.open_font(p.ptr, ptsize)

    if f == null then None else Some(Font(f))
end open_font

private surface_of(p: *CSurface) -> Option[&Surface] = if p == null then None else Some(Surface(p))
