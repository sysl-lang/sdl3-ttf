// SDL_ttf 3 — text rendered from a font file, for sysl.
//
//     dependencies {
//       sdl3-ttf { git = "github.com/sysl-lang/sdl3-ttf", version = "0.1.0" }
//     }
//
// **SDL3 and SDL3_ttf both have to be installed** — `brew install sdl3_ttf` pulls both — and a
// build needs the prefix on the command line:
//
//     sysl run prog.sysl --include-path /opt/homebrew/include --link-path /opt/homebrew/lib
//
// This is a separate package from `sdl3` rather than a module inside it, and the reason is
// mechanical: a link directive is never pruned, so a program that only drew rectangles would still
// be handed `-lSDL3_ttf` and would not link on a machine without it.

package {
  name    = "sdl3-ttf"
  version = "0.1.0"
}

// The core binding, for `Color`, `Surface`, `Renderer` and `Texture`. It is fetched by the
// coordinate below, so nothing has to be checked out beside this repository.
dependencies {
  sdl3 { git = "github.com/sysl-lang/sdl3", version = "0.1.0" }
}

requires {
  heap  = true
  posix = true
}
